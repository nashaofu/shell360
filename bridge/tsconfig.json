{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["DOM", "ES2022"],
    "module": "ESNext",
    "noEmit": false,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "useDefineForClassFields": true,
    "allowImportingTsExtensions": true,
    "composite": true,
    "declaration": true,
    "declarationDir": "dist",
    "emitDeclarationOnly": true,
    "paths": {
      "jsb": ["../jsb/dist/index.d.ts"]
    }
  },
  "include": ["src"],
  "references": [
    { "path": "../jsb" },
    { "path": "../tauri-plugin-data" },
    { "path": "../tauri-plugin-pty" },
    { "path": "../tauri-plugin-ssh" }
  ]
}
