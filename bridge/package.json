    "./ssh": {
      "types": "./dist/src/ssh.d.ts",
      "import": "./src/ssh.ts",
      "default": "./src/ssh.ts"
    },
    "./store": {
      "types": "./dist/src/store.d.ts",
      "import": "./src/store.ts",
