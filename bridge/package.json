{
  "name": "bridge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./app": {
      "types": "./dist/src/app.d.ts",
      "import": "./src/app.ts",
      "default": "./src/app.ts"
    },
    "./backend": {
      "types": "./dist/src/backend.d.ts",
      "import": "./src/backend.ts",
      "default": "./src/backend.ts"
    },
    "./capabilities": {
      "types": "./dist/src/capabilities.d.ts",
      "import": "./src/capabilities.ts",
