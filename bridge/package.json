      "default": "./src/tauri.ts"
    },
    "./updater": {
      "types": "./dist/src/updater.d.ts",
      "import": "./src/updater.ts",
      "default": "./src/updater.ts"
    },
    "./window": {
      "types": "./dist/src/window.d.ts",
      "import": "./src/window.ts",
      "default": "./src/window.ts"
