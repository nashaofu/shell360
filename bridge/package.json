    "./data": {
      "types": "./dist/src/data.d.ts",
      "import": "./src/data.ts",
      "default": "./src/data.ts"
    },
    "./dialog": {
      "types": "./dist/src/dialog.d.ts",
      "import": "./src/dialog.ts",
      "default": "./src/dialog.ts"
    },
    "./fs": {
      "types": "./dist/src/fs.d.ts",
