{
  "name": "shell360",
  "version": "0.0.0",
  "description": "A cross-platform SSH and SFTP client.",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "tauri": "tauri",
    "dotenvx": "dotenvx run --",
    "check": "biome check .",
    "check:fix": "biome check . --write",
    "tsc": "pnpm --filter \"*\" run tsc",
    "build": "pnpm --filter \"*\" run build",
    "android:dev": "node scripts/android/index.ts dev",
    "android:build": "node scripts/android/index.ts build",
    "ios:web-assets": "node scripts/ios/index.ts web-assets",
    "ios:build-native": "node scripts/ios/index.ts build-native",
    "ios:dev": "node scripts/ios/index.ts dev",
    "ios:build": "node scripts/ios/index.ts build",
    "harmonyos:dev": "node scripts/harmonyos/index.ts dev",
    "harmonyos:build": "node scripts/harmonyos/index.ts build"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@deveco/deveco-cli": "^1.3.10",
    "@dotenvx/dotenvx": "^2.38.2",
    "@inquirer/select": "^5.2.8",
    "@tauri-apps/cli": "^2.12.4",
    "@types/yargs": "^17.0.35",
    "execa": "^10.2.1",
    "exit-hook": "^5.1.0",
    "fkill": "^10.0.3",
    "glob": "^14.0.3",
    "got": "^16.2.0",
    "json5": "^2.2.3",
    "smol-toml": "^1.9.1",
    "typescript": "^7.0.2",
    "wait-on": "^9.5.1",
    "yargs": "^18.2.0"
  },
  "dependencies": {
    "uuid": "^14.0.3"
  }
}
