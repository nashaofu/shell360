{
  "name": "shell360",
  "version": "0.0.0",
  "description": "A cross-platform SSH and SFTP client.",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "tauri": "tauri",
    "dotenvx": "dotenvx run --",
    "check": "biome check .",
    "check:fix": "biome check . --write",
    "tsc": "pnpm --filter \"*\" run tsc",
    "build": "pnpm --filter \"*\" run build",
    "android:dev": "node scripts/android.js dev",
    "android:build": "node scripts/android.js build"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@dotenvx/dotenvx": "^1.75.1",
    "@inquirer/select": "^5.2.1",
    "@tauri-apps/cli": "^2.11.3",
    "execa": "^9.6.1",
    "glob": "^13.0.6",
    "got": "^15.0.5",
    "typescript": "^6.0.3",
    "yargs": "^18.1.0"
  }
}
